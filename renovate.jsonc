{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigestsToSemver",
        "group:allNonMajor"
    ],
    "commitBodyTable": true,
    // Keep the PR body short: drop the config description, rebase checkbox, footer
    // and inline release notes. The table links to the release notes instead.
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}",
    "prBodyColumns": [
        "Package",
        "Type",
        "Update",
        "Change",
        "Pending",
        "Release notes"
    ],
    "prBodyDefinitions": {
        "Release notes": "{{#each releases}}{{#if releaseNotes.url}}[{{{version}}}]({{{releaseNotes.url}}}) {{/if}}{{/each}}"
    },
    "description": "Global branch-creation cadence: Renovate may only open update branches on Saturdays.",
    // See https://crontab.cronhub.io/ for cheatsheet on crontab syntax and translation to natural language.
    "schedule": [
        "* * * * 6"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "* * * * 6"
        ]
    },
    "packageRules": [
        {
            "description": "Keep breaking updates out of the weekly group. A 0.x minor update, such as 0.29 to 0.30, is breaking but has the type minor.",
            "matchIsBreaking": true,
            "groupName": null,
            "groupSlug": null
        },
        {
            "description": "Change Cargo.toml only when a new version is out of range. Lock file maintenance does the in-range updates.",
            "matchManagers": [
                "cargo"
            ],
            "rangeStrategy": "replace"
        },
        {
            "description": "The root .python-version is the oldest supported Python, and docs/.python-version matches the docs CI. Do not bump them to the newest release.",
            "matchManagers": [
                "pyenv"
            ],
            "enabled": false
        },
        {
            "description": "Update the Rust Driver revision manually. Do not follow its main branch.",
            "matchManagers": [
                "cargo"
            ],
            // For a git dependency, the package name is the repository URL.
            "matchPackageNames": [
                "https://github.com/scylladb/scylla-rust-driver"
            ],
            "enabled": false
        },
        {
            "description": "pyo3 and pyo3-build-config are pinned to the same exact version, and pyo3-log limits the pyo3 versions it accepts. Update them together. A new pyo3 often needs an in-range pyo3-log update, so keep the in-range updates for this group.",
            "groupName": "PyO3",
            "rangeStrategy": "update-lockfile",
            "matchManagers": [
                "cargo"
            ],
            "matchPackageNames": [
                "pyo3",
                "pyo3-build-config",
                "pyo3-log"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "pinDigests": true,
            "minimumReleaseAge": "90 days"
        },
        {
            "description": "Skip wait period for scylladb actions. This is generally a no-op, because minimumReleaseAge doesn't work for pure hashes on branches - it needs releases. Keeping it here in case this changes in the future.",
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "/^scylladb-actions\\//",
                "/^scylladb\\//"
            ],
            "minimumReleaseAge": null
        }
    ]
}
